# Public build settings for the Chinese landing page.
SITE_URL=https://pnpline.cn

# Leave the API URL empty to keep the form in preview mode.
NEXT_PUBLIC_INQUIRY_API_URL=
# Must match INQUIRY_CONSENT_VERSION on the intake function.
NEXT_PUBLIC_INQUIRY_CONSENT_VERSION=
NEXT_PUBLIC_INQUIRY_PRIVACY_OPERATOR="懿多贸易（深圳）有限公司"
NEXT_PUBLIC_INQUIRY_PRIVACY_EMAIL=contact@inquiry.pnpline.cn
NEXT_PUBLIC_INQUIRY_PRIVACY_RECIPIENT_NOTICE=
NEXT_PUBLIC_INQUIRY_PRIVACY_RETENTION_NOTICE=
